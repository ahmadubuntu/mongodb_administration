# Example inventory — copy to a gitignored *.env and adjust.
# Rule: the script only probes ports listed here. Never guess ports in code.
#
#   cp config/clusters/devmongo.example.env config/clusters/devmongo.env
#   cp config/clusters/stgmongo.example.env config/clusters/stgmongo.env

CLUSTER_NAME="mongo example"
SSH_PORT=7412

# VIP / LB disabled by default for current replica sets (leave empty)
VIP_HOST=""
VIP_CLIENT_PORTS=""
LB_HOSTS=""
LB_CLIENT_PORTS=""
LB_BACKEND_PORTS=""

MONGO_MODE="replicaset"
REPLICA_SET_NAME="rs0"

MONGOD_HOSTS="10.0.0.11,10.0.0.12,10.0.0.13"
MONGOS_HOSTS=""
CONFIGSVR_HOSTS=""
SHARD_NAMES=""

# Verified on live nodes: mongod listens on 5061 (not 27017)
MONGO_PORT=5061
MONGO_PORTS="5061"
MONGOS_PORT=5061
CONFIGSVR_PORT=27019
MONGO_ADMIN_PORTS=""

# Prefer MONGO_URI in the gitignored *.env — never commit passwords
# MONGO_URI="mongodb://user:pass@HOST:5061/?authSource=admin"
MONGO_USER=""
MONGO_PASSWORD=""
MONGO_AUTH_DB="admin"
MONGO_URI_OPTS=""
MONGO_BIN=""
MONGO_CONF="/etc/mongod.conf"
MONGO_DBPATH="/var/lib/mongodb"
MONGOD_SYSTEMD_UNIT="mongod"
MONGOS_SYSTEMD_UNIT="mongos"
CONFIGSVR_SYSTEMD_UNIT="mongod"
MONGO_PROBE_TIMEOUT_SEC=15
MONGO_ADMIN_TIMEOUT_SEC=30

CHECKER_REACHABLE_PORTS="5061,7412"
CLUSTER_INTERNAL_PORTS=""

ALLOW_PORTS_MONGO="5061"
ALLOW_PORTS_MONGOD="5061"
ALLOW_PORTS_MONGOS="5061"
ALLOW_PORTS_CONFIGSVR="27019"
ALLOW_PORTS_LB=""
ALLOW_PORTS_VIP=""
# Monitoring / agents (aligned with postgres_realtime_check GEN)
ALLOW_PORTS_AGENTS="10050,15000,15001,30523,9100"

EXPECT_MEMBERS="3"
EXPECT_BALANCER=""
EXPECT_FCV=""
EXPECT_TLS="0"
EXPECT_BACKUP=0

DISK_WARN_PCT=80
DISK_FAIL_PCT=90
LOAD_WARN_RATIO=1.5
LOAD_FAIL_RATIO=3.0
CONN_WARN_PCT=70
CONN_FAIL_PCT=90
CONN_SOFT_CEILING=2000
LAG_WARN_SEC=10
LAG_FAIL_SEC=60
OPLOG_WARN_HOURS=24
OPLOG_FAIL_HOURS=6
WT_DIRTY_WARN_PCT=50
WT_DIRTY_FAIL_PCT=80
ELECTION_RECENT_WARN_SEC=3600
QUERY_WARN_MS=100
TOP_QUERY_WARN_MS=50
TOP_QUERY_FAIL_MS=200
TOP_MIN_OPS=20
EXPLAIN_WARN_MS=50
EXPLAIN_FAIL_MS=500
LIVE_SLOW_SEC=1
QUERY_FAIL_MS=500
QUERY_ONBOX_WARN_MS=20
QUERY_ONBOX_FAIL_MS=200
TCP_TIMEOUT_SEC=3
SSH_TIMEOUT_SEC=12
SSH_RETRY_TIMEOUT_SEC=35
SSH_SLOW_WARN_MS=3000
PARALLEL_JOBS=8
SSH_CONTROL_PERSIST_SEC=120
